# --- Akahu (personal app, shared household token pair) ---
# From my.akahu.nz -> Developers.
AKAHU_APP_TOKEN=
AKAHU_USER_TOKEN=

# --- Supabase ---
# Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings -> Database. Use the pooled ("Transaction" mode)
# connection string for the app, and the direct connection for migrations.
DATABASE_URL=
DIRECT_URL=

# --- Auth ---
# Comma-separated list of emails allowed to sign in (you + your wife).
ALLOWED_EMAILS=

# --- Cron ---
# Random secret; also set as the Authorization: Bearer header Vercel Cron
# sends. Generate with `openssl rand -hex 32`.
CRON_SECRET=

# --- AI (Phase 2 — categorisation) ---
AI_GATEWAY_API_KEY=
